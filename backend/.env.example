NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Postgres (Render Postgres / Heroku Postgres / Neon / Supabase)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/explainer

# Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8787
FRONTEND_URL=http://localhost:4321
TRUSTED_ORIGINS=http://localhost:4321

# Storage: local (dev/Render disk) or s3 (Cloudflare R2, AWS S3, Backblaze B2)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:8787

# S3-compatible storage (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=explainer-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://media.explainer.africa

# Email (Resend). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=news@explainer.africa

# Scheduled publishing / cron
CRON_SECRET=replace-with-a-long-random-string

# Read-only server-to-server access for Astro previews of unpublished stories
INTERNAL_API_KEY=replace-with-a-long-random-string

# First superadmin, used only by `bun run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Newsroom Admin

# Optional: only needed for the one-time Appwrite export
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=vox_cms
APPWRITE_BUCKET_ID=media
