---
import MainLayout from "../../layouts/MainLayout.astro";
import VoxNav from "../../components/ui/VoxNav.astro";
import StreamCard from "../../components/ui/StreamCard.astro";
import Footer from "../../components/Footer.astro";
import { serverAuthorService, serverStoryService } from "../../lib/server-appwrite.js";
import { Mail, Twitter } from 'lucide-react';
import { Image } from "astro:assets";

export const prerender = false;

const { slug } = Astro.params;

// Fetch the live author record (never throw: a miss falls back to the slug)
let authorRecord: any = null;
try {
  authorRecord = await serverAuthorService.getAuthorBySlug(slug);
} catch (error: any) {
  console.error(`[AUTHOR] Failed to fetch author "${slug}":`, error?.message || error);
}

// Derive a display name from the slug ("chioma-okafor" -> "Chioma Okafor")
const nameFromSlug = slug
  ? slug
      .split("-")
      .filter(Boolean)
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ")
  : "";

const name = authorRecord?.name || nameFromSlug;

// Match stories against both the record name and the slug-derived name
const nameKeys = new Set(
  [authorRecord?.name, nameFromSlug]
    .filter(Boolean)
    .map((value) => (value as string).trim().toLowerCase()),
);

const publishedStories = await serverStoryService.getPublishedStories();
const authorStories = publishedStories.filter(
  (s: any) => s?.author && nameKeys.has(String(s.author).trim().toLowerCase()),
);

// A slug with no author record and no published stories is a genuine miss.
if (!authorRecord && authorStories.length === 0) {
  return Astro.redirect("/404");
}

const author = {
  name,
  slug: authorRecord?.slug || slug,
  role: authorRecord?.role || "",
  bio: authorRecord?.bio || "",
  email: authorRecord?.email || "",
  imageUrl: authorRecord?.imageUrl || "",
  social: authorRecord?.social || {},
};

const avatarUrl =
  author.imageUrl || `https://api.dicebear.com/7.x/avataaars/svg?seed=${author.name}`;
---

<MainLayout 
    title={`${author.name} - Explainer`}
    description={author.bio}
    image={avatarUrl}
>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": author.name,
        "jobTitle": author.role || undefined,
        "description": author.bio || undefined,
        "url": `https://explainer.africa/author/${author.slug}`,
        "image": avatarUrl,
        "sameAs": [
            author.social?.twitter ? `https://twitter.com/${author.social.twitter.replace('@', '')}` : null,
            author.social?.linkedin ? `https://${author.social.linkedin}` : null
        ].filter(Boolean)
    }).replace(/</g, '\\u003c')}
  />
  <VoxNav />
  
  <main class="min-h-screen bg-[#fdfdfd]">
    <div class="bg-gray-50 border-b border-gray-200">
        <div class="max-w-4xl mx-auto px-6 py-20 text-center">
            <div class="mb-8 relative inline-block">
                <div class="w-32 h-32 rounded-full bg-white border-4 border-white shadow-md overflow-hidden mx-auto">
                    <Image 
                        src={avatarUrl} 
                        alt={author.name} 
                        width={128}
                        height={128}
                        class="w-full h-full object-cover" 
                    />
                </div>
            </div>
            <h1 class="font-serif-display font-black text-4xl md:text-5xl text-black mb-3">{author.name}</h1>
            {author.role && <p class="text-[#008751] font-bold uppercase tracking-widest text-xs mb-6">{author.role}</p>}
            {author.bio && <p class="text-xl text-gray-600 font-serif leading-relaxed max-w-2xl mx-auto mb-8">{author.bio}</p>}
            <div class="flex justify-center gap-4">
                {author.email && <a href={`mailto:${author.email}`} class="p-2 text-gray-400 hover:text-black border border-transparent hover:border-gray-200 shadow-sm rounded-full"><Mail className="w-5 h-5" /></a>}
                {author.social?.twitter && <a href={`https://twitter.com/${author.social.twitter.replace('@', '')}`} class="p-2 text-gray-400 hover:text-[#1DA1F2] border border-transparent hover:border-gray-200 shadow-sm rounded-full"><Twitter className="w-5 h-5" /></a>}
            </div>
        </div>
    </div>

    <div class="max-w-4xl mx-auto px-6 py-16">
        <div class="flex items-center justify-between border-b-2 border-black pb-4 mb-12">
            <h2 class="text-xl font-black uppercase tracking-wider">Latest from {author.name.split(' ')[0]}</h2>
            <span class="text-gray-500 font-serif text-sm italic">{authorStories.length} Articles</span>
        </div>

        <div class="space-y-12">
            {authorStories.length > 0 ? (
                authorStories.map((story: any) => (
                    <StreamCard article={story as any} />
                ))
            ) : (
                <div class="text-center py-20 bg-gray-50 rounded-lg border border-dashed border-gray-300">
                    <p class="text-gray-500 font-serif italic text-lg">No published articles yet.</p>
                </div>
            )}
        </div>
    </div>
  </main>
  <Footer />
</MainLayout>
