---
import MediaLibrary from '../../components/admin/MediaLibrary';
import AdminSidebar from '../../components/admin/AdminSidebar';

const title = 'Media Library';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Explainer Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="min-h-screen flex">
        <AdminSidebar activePage="media" client:only="react" />
        
        <main class="lg:ml-64 flex-1 p-4 md:p-8 pt-24 lg:pt-8">
            <header class="mb-8">
                <h1 class="text-3xl font-black text-gray-900 uppercase tracking-tighter">Media Library</h1>
                <p class="text-gray-500 text-sm font-medium">Manage and organize your visual assets.</p>
            </header>
            
            <div class="h-[calc(100vh-200px)]">
                <MediaLibrary client:only="react" mode="browse" />
            </div>
        </main>
    </div>
</body>
</html>