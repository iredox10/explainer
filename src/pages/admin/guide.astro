---
import AdminSidebar from "../../components/admin/AdminSidebar.jsx";
import {
    BookOpen,
    Map,
    BarChart2,
    Video,
    Type,
    CheckCircle,
    Shield,
    LayoutDashboard,
    FileText,
    Tags,
    Users,
    Mail,
    Inbox,
    Settings,
    Activity,
    Layers,
    Eye,
} from "lucide-react";
import "../../styles/base.css";
import "../../styles/global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Editorial Guide - Explainer CMS</title>
    </head>
    <body class="bg-gray-50">
        <div class="min-h-screen flex font-sans text-gray-900">
            <AdminSidebar activePage="guide" client:only="react" />

            <main
                class="lg:ml-64 flex-1 p-4 md:p-8 lg:p-12 pt-24 lg:pt-12 max-w-5xl"
            >
                <header class="mb-12 md:mb-16">
                    <div
                        class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-6"
                    >
                        <div class="bg-black p-3 rounded-2xl text-[#FAFF00]">
                            <BookOpen className="w-6 h-6 md:w-8 md:h-8" />
                        </div>
                        <div>
                            <h1
                                class="text-3xl md:text-4xl font-black text-gray-900 uppercase tracking-tighter"
                            >
                                Systems Manual
                            </h1>
                            <p
                                class="text-gray-500 text-sm md:text-base font-medium"
                            >
                                The complete guide to operating Explainer.OS
                            </p>
                        </div>
                    </div>
                </header>

                <div class="space-y-12">
                    <div
                        class="bg-black text-white p-8 rounded-3xl md:rounded-[2.5rem] relative overflow-hidden"
                    >
                        <div
                            class="absolute top-0 right-0 w-64 h-64 bg-[#FAFF00] rounded-full mix-blend-overlay blur-[100px] opacity-20"
                        >
                        </div>
                        <h2
                            class="font-serif-display text-4xl mb-4 text-[#FAFF00]"
                        >
                            Welcome to the Command Center
                        </h2>
                        <p
                            class="text-lg text-gray-400 font-serif leading-relaxed max-w-2xl"
                        >
                            This system is designed modularly. You manage
                            Content, the Engine handles Presentation. Here is
                            how your newsroom fits together.
                        </p>
                    </div>

                    <!-- Core Modules -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Dashboard -->
                        <div
                            class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm flex items-start gap-4"
                        >
                            <div class="shrink-0 bg-gray-50 p-3 rounded-xl">
                                <LayoutDashboard class="w-6 h-6 text-black" />
                            </div>
                            <div>
                                <h3
                                    class="text-lg font-black uppercase tracking-tighter mb-2"
                                >
                                    Command Center (Dashboard)
                                </h3>
                                <p
                                    class="text-sm text-gray-500 leading-relaxed"
                                >
                                    Your high-level dashboard. View real-time
                                    aggregated stats of pending vs published
                                    articles, recent draft alerts, and overall
                                    system health.
                                </p>
                            </div>
                        </div>
                        <!-- Article Desk -->
                        <div
                            class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm border-l-4 border-l-[#FAFF00] flex items-start gap-4"
                        >
                            <div
                                class="shrink-0 bg-[#FAFF00]/20 p-3 rounded-xl"
                            >
                                <FileText class="w-6 h-6 text-black" />
                            </div>
                            <div>
                                <h3
                                    class="text-lg font-black uppercase tracking-tighter mb-2"
                                >
                                    Article Desk
                                </h3>
                                <p
                                    class="text-sm text-gray-500 leading-relaxed"
                                >
                                    The beating heart of the CMS. Where you
                                    write, drag-and-drop interactive components,
                                    assign Series, and set article states from
                                    Draft to Published.
                                </p>
                            </div>
                        </div>
                    </div>

                    <hr class="border-gray-200" />

                    <!-- Part 2: Blocks -->
                    <div>
                        <h3
                            class="text-sm font-black uppercase tracking-widest text-gray-400 mb-6 border-b border-gray-200 pb-2"
                        >
                            The Building Blocks
                        </h3>
                        <div class="space-y-6">
                            <div
                                class="bg-white p-6 md:p-8 rounded-3xl shadow-sm border border-gray-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow"
                            >
                                <div
                                    class="bg-gray-50 p-4 rounded-2xl shrink-0"
                                >
                                    <Video class="w-6 h-6 text-black" />
                                </div>
                                <div>
                                    <h4
                                        class="text-lg font-black uppercase tracking-tighter mb-2"
                                    >
                                        1. Video Backgrounds & Scrolly Blocks
                                    </h4>
                                    <p class="text-sm text-gray-600 mb-4">
                                        You can set a direct MP4 link as the
                                        hero area of an article. Within the
                                        article, inserting a "Scrolly Group"
                                        creates a full-screen interactive
                                        progression relying on Map or Timeline
                                        blocks.
                                    </p>
                                </div>
                            </div>

                            <div
                                class="bg-white p-6 md:p-8 rounded-3xl shadow-sm border border-gray-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow"
                            >
                                <div
                                    class="bg-gray-50 p-4 rounded-2xl shrink-0"
                                >
                                    <Map class="w-6 h-6 text-black" />
                                </div>
                                <div>
                                    <h4
                                        class="text-lg font-black uppercase tracking-tighter mb-2"
                                    >
                                        2. The Geographic Map "Fly-To"
                                    </h4>
                                    <p class="text-sm text-gray-600 mb-2">
                                        When chaining <strong>Map blocks</strong
                                        > in a Scrolly Group, set progressive Coordinates
                                        (Longitude, Latitude) and Zoom levels (1 for
                                        Continent, 8 for Country, 12+ for City).
                                    </p>
                                    <p class="text-xs text-gray-400">
                                        Pro-Tip: Use the "Highlight" parameter
                                        with lowercase country names to
                                        selectively mask regions.
                                    </p>
                                </div>
                            </div>

                            <div
                                class="bg-white p-6 md:p-8 rounded-3xl shadow-sm border border-gray-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow"
                            >
                                <div
                                    class="bg-gray-50 p-4 rounded-2xl shrink-0"
                                >
                                    <BarChart2 class="w-6 h-6 text-black" />
                                </div>
                                <div>
                                    <h4
                                        class="text-lg font-black uppercase tracking-tighter mb-2"
                                    >
                                        3. Data Pulses (Charts)
                                    </h4>
                                    <p class="text-sm text-gray-600 mb-2">
                                        Insert interactive standard arrays <code
                                            class="bg-gray-100 px-1 rounded text-red-600"
                                            >[10, 45, 90, 32]</code
                                        > and define their Type (Line, Bar) to have
                                        them auto-animate as the user scrolls them
                                        into view.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="border-gray-200" />

                    <!-- Part 3: Protocols -->
                    <div>
                        <h3
                            class="text-sm font-black uppercase tracking-widest text-gray-400 mb-6 border-b border-gray-200 pb-2"
                        >
                            Editorial Protocols & Series
                        </h3>
                        <div
                            class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm space-y-8 hover:shadow-md transition-shadow"
                        >
                            <div>
                                <h4
                                    class="text-lg font-black uppercase tracking-tighter mb-2 flex items-center gap-2"
                                >
                                    <Layers class="w-5 h-5 text-blue-500" /> Core
                                    Layout Protocols
                                </h4>
                                <p class="text-sm text-gray-600 mb-6">
                                    Select these from the editor's right-hand
                                    configuration panel:
                                </p>
                                <div
                                    class="grid grid-cols-1 md:grid-cols-2 gap-4"
                                >
                                    <div
                                        class="bg-gray-50 p-4 rounded-xl border border-gray-100"
                                    >
                                        <div
                                            class="text-[10px] font-black uppercase tracking-widest text-black mb-1"
                                        >
                                            Standard
                                        </div>
                                        <div class="text-xs text-gray-500">
                                            Traditional article layout. Best for
                                            standard reporting.
                                        </div>
                                    </div>
                                    <div
                                        class="bg-[#FAFF00]/10 p-4 rounded-xl border border-[#FAFF00]"
                                    >
                                        <div
                                            class="text-[10px] font-black uppercase tracking-widest text-black mb-1"
                                        >
                                            Explainer (Scrolly)
                                        </div>
                                        <div
                                            class="text-xs text-black font-medium"
                                        >
                                            Activates the immersive engine for
                                            full-viewport scroll storytelling.
                                        </div>
                                    </div>
                                    <div
                                        class="bg-red-50 p-4 rounded-xl border border-red-200"
                                    >
                                        <div
                                            class="text-[10px] font-black uppercase tracking-widest text-red-600 mb-1"
                                        >
                                            Briefing
                                        </div>
                                        <div class="text-xs text-gray-600">
                                            Fast news. Uses a narrow center
                                            column. No complex blocks allowed.
                                        </div>
                                    </div>
                                    <div
                                        class="bg-black p-4 rounded-xl border border-gray-800"
                                    >
                                        <div
                                            class="text-[10px] font-black uppercase tracking-widest text-[#FAFF00] mb-1"
                                        >
                                            Photo Essay
                                        </div>
                                        <div class="text-xs text-gray-400">
                                            Total immersion. Forces a dark-theme
                                            system and edge-to-edge grayscale
                                            imagery.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-6 border-t border-gray-100">
                                <h4
                                    class="text-lg font-black uppercase tracking-tighter mb-2 flex items-center gap-2"
                                >
                                    <BookOpen class="w-5 h-5 text-green-500" /> Managing
                                    Series
                                </h4>
                                <p class="text-sm text-gray-600 mb-4">
                                    To group articles together into a cohesive
                                    package (like "The Tech Boom"):
                                </p>
                                <ul
                                    class="text-sm text-gray-600 space-y-2 list-disc pl-5"
                                >
                                    <li>
                                        Assign the <strong>Series Slug</strong> in
                                        the sidebar (e.g. <code
                                            class="bg-gray-100 px-1 rounded"
                                            >tech-boom</code
                                        >). Keep this identical across all
                                        related articles.
                                    </li>
                                    <li>
                                        Assign the <strong
                                            >Series Part Number</strong
                                        > (e.g. <code
                                            class="bg-gray-100 px-1 rounded"
                                            >1</code
                                        >, <code
                                            class="bg-gray-100 px-1 rounded"
                                            >2</code
                                        >). This generates the automated "Up
                                        Next" navigator.
                                    </li>
                                    <li>
                                        For standard inline linking (not a
                                        series), use the <strong
                                            >Inline Related</strong
                                        > block inside the main text editor instead.
                                    </li>
                                </ul>
                            </div>

                            <div
                                class="bg-gray-100 p-4 rounded-xl flex items-start gap-4"
                            >
                                <Eye class="w-6 h-6 text-black shrink-0" />
                                <div>
                                    <h5
                                        class="text-xs font-black uppercase tracking-widest"
                                    >
                                        Ghost Live Preview
                                    </h5>
                                    <p class="text-xs text-gray-600 mt-1">
                                        Click the Eye icon in the editor toolbar
                                        to open Ghost Preview. This splits your
                                        screen and runs the actual frontend
                                        engine so you can verify exactly how
                                        Protocols, Scrolly blocks, and Series UI
                                        look in real-time.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="border-gray-200" />

                    <!-- Newsroom Management -->
                    <div>
                        <h3
                            class="text-sm font-black uppercase tracking-widest text-gray-400 mb-6 border-b border-gray-200 pb-2"
                        >
                            Newsroom Management
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div
                                class="bg-white p-6 rounded-3xl border border-gray-100 flex items-start gap-4 hover:shadow-md transition-shadow"
                            >
                                <Tags class="w-6 h-6 text-black shrink-0" />
                                <div>
                                    <h4
                                        class="text-sm font-black uppercase tracking-widest text-black mb-1"
                                    >
                                        Verticals (Categories)
                                    </h4>
                                    <p class="text-xs text-gray-500">
                                        Create the primary sections of your
                                        website (Politics, Tech). This controls
                                        main navigation grouping.
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-6 rounded-3xl border border-gray-100 flex items-start gap-4 hover:shadow-md transition-shadow"
                            >
                                <Users class="w-6 h-6 text-black shrink-0" />
                                <div>
                                    <h4
                                        class="text-sm font-black uppercase tracking-widest text-black mb-1"
                                    >
                                        Directory (Authors)
                                    </h4>
                                    <p class="text-xs text-gray-500">
                                        Maintain author profiles, bios, and
                                        headshots for the global staff
                                        directory.
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-6 rounded-3xl border border-gray-100 flex items-start gap-4 hover:shadow-md transition-shadow"
                            >
                                <Mail class="w-6 h-6 text-black shrink-0" />
                                <div>
                                    <h4
                                        class="text-sm font-black uppercase tracking-widest text-black mb-1"
                                    >
                                        Newsletters
                                    </h4>
                                    <p class="text-xs text-gray-500">
                                        Manage audience email connections and
                                        external distribution channels.
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-6 rounded-3xl border border-gray-100 flex items-start gap-4 hover:shadow-md transition-shadow"
                            >
                                <Inbox class="w-6 h-6 text-black shrink-0" />
                                <div>
                                    <h4
                                        class="text-sm font-black uppercase tracking-widest text-black mb-1"
                                    >
                                        Guest Queue (Submissions)
                                    </h4>
                                    <p class="text-xs text-gray-500">
                                        Review pitches and drafts submitted by
                                        freelancers through the external
                                        submission portal.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="border-gray-200" />

                    <!-- Enterprise Control -->
                    <div>
                        <h3
                            class="text-sm font-black uppercase tracking-widest text-red-500 mb-6 border-b border-gray-200 pb-2 flex items-center gap-2"
                        >
                            <Shield class="w-4 h-4" /> Enterprise Security
                        </h3>
                        <div
                            class="bg-red-50 border border-red-100 p-8 rounded-3xl space-y-6 hover:shadow-md transition-shadow"
                        >
                            <div class="flex items-start gap-4">
                                <Users
                                    class="w-6 h-6 text-red-600 shrink-0 mt-1"
                                />
                                <div>
                                    <h4
                                        class="text-sm font-black uppercase tracking-widest text-red-900 mb-2"
                                    >
                                        Team & Access (Invitations)
                                    </h4>
                                    <p
                                        class="text-sm text-red-800 leading-relaxed"
                                    >
                                        Only Superadmins can invite new
                                        journalists. If an invitation fails with <code
                                            class="bg-red-100 px-1 rounded"
                                            >User is not allowed to send
                                            invitations</code
                                        >, ensure the Superadmin account also
                                        holds the 'Owner' rule in the backend
                                        Appwrite Team settings.
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-start gap-4">
                                <Settings
                                    class="w-6 h-6 text-red-600 shrink-0 mt-1"
                                />
                                <div>
                                    <h4
                                        class="text-sm font-black uppercase tracking-widest text-red-900 mb-2"
                                    >
                                        Global Protocols & Logs
                                    </h4>
                                    <p
                                        class="text-sm text-red-800 leading-relaxed"
                                    >
                                        <strong>Settings:</strong> Maintain system-wide
                                        constants, master API keys, and global feature
                                        flags. <br /><strong
                                            >System Logs:</strong
                                        > Provide an audit trail of who published
                                        what, and when, for security compliance.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <footer
                    class="mt-12 md:mt-20 pt-10 border-t border-gray-100 flex flex-col sm:flex-row justify-between items-center bg-gray-50 gap-6"
                >
                    <div
                        class="text-[10px] font-black uppercase tracking-widest text-gray-400"
                    >
                        Explainer Systems OS
                    </div>
                    <button
                        onclick="window.location.href = '/admin'"
                        class="w-full sm:w-auto text-[10px] font-black uppercase tracking-widest bg-black text-white px-6 py-3 rounded-xl hover:bg-[#FAFF00] hover:text-black transition-all"
                    >
                        Return to Command Center
                    </button>
                </footer>
            </main>
        </div>
    </body>
</html>
