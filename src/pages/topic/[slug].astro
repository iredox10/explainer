---
import MainLayout from "../../layouts/MainLayout.astro";
import StreamCard from "../../components/ui/StreamCard.astro";
import Footer from "../../components/Footer.astro";
import {
  serverStoryService,
  serverCategoryService,
} from "../../lib/server-appwrite.js";
import { VOX_HOME_DATA } from "../../data/mock";

export const prerender = false;

const { slug } = Astro.params;

// Fetch Live Category Data (never throw: page must still render)
let categoryRecord: any = null;
try {
  categoryRecord = await serverCategoryService.getCategoryBySlug(slug);
} catch (error: any) {
  console.error(`[TOPIC] Failed to fetch category "${slug}":`, error?.message || error);
}

// Logic mapping if the API is empty or for fallback styling
const categoryMap: Record<
  string,
  { title: string; description: string; color: string; accent: string }
> = {
  politics: {
    title: "Politics",
    description: "Power, policy, and the people who shape it.",
    color: "#BFDBFE",
    accent: "#2563EB",
  },
  technology: {
    title: "Technology",
    description: "The future is already here.",
    color: "#FEF08A",
    accent: "#CA8A04",
  },
  culture: {
    title: "Culture",
    description: "How we live, what we consume, and who we are.",
    color: "#FBCFE8",
    accent: "#DB2777",
  },
  science: {
    title: "Science",
    description: "Discoveries that change our understanding of the universe.",
    color: "#BBF7D0",
    accent: "#16A34A",
  },
};

// Derive a display name from the slug ("super-feature" -> "Super Feature")
const titleFromSlug = slug
  ? slug
      .split("-")
      .filter(Boolean)
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ")
  : "";

const fallbackData = slug ? categoryMap[slug] : null;

// Live record wins, then the static map, then the slug-derived name
const title = categoryRecord?.name || fallbackData?.title || titleFromSlug;

if (!title) {
  return Astro.redirect("/404");
}

const description =
  categoryRecord?.description ||
  fallbackData?.description ||
  "In-depth investigative journalism and visual storytelling.";

// Colors are stored as hex; only fall back to Vox yellow when no color exists
// (#000000 is a valid stored default for text-on-color backgrounds).
const color = categoryRecord?.color || fallbackData?.color || "#FAFF00";
const accent =
  categoryRecord?.accentColor ||
  categoryRecord?.accentClass ||
  fallbackData?.accent ||
  color;

// Categories default to #000000, so the header text cannot be hardcoded black.
const isDarkHex = (hex: string): boolean => {
  const match = /^#?([0-9a-f]{6})$/i.exec(String(hex).trim());
  if (!match) return false;
  const value = parseInt(match[1], 16);
  const r = (value >> 16) & 255;
  const g = (value >> 8) & 255;
  const b = value & 255;
  return (0.299 * r + 0.587 * g + 0.114 * b) / 255 < 0.5;
};

const headerText = isDarkHex(color) ? "text-white" : "text-black";

// Match stories against both the record name and the slug-derived name
const titleKeys = new Set(
  [title, titleFromSlug, slug?.replace(/-/g, " ")]
    .filter(Boolean)
    .map((value) => (value as string).trim().toLowerCase()),
);

// Fetch live stories for this category
const allPublished = await serverStoryService.getPublishedStories();
const categoryStories = allPublished.filter(
  (s: any) =>
    s?.category && titleKeys.has(String(s.category).trim().toLowerCase()),
);

// A slug with no category record, no static fallback and no published stories
// is a genuine miss, not an empty topic page.
if (!categoryRecord && !fallbackData && categoryStories.length === 0) {
  return Astro.redirect("/404");
}


// Top sibling topics for quick section navigation
const topicCounts = new Map<string, number>();
for (const s of allPublished) {
  const cat = String(s?.category || "").trim();
  if (cat && cat.toLowerCase() !== title.toLowerCase()) {
    topicCounts.set(cat, (topicCounts.get(cat) || 0) + 1);
  }
}
const relatedTopics = Array.from(topicCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4)
  .map(([name]) => ({
    name,
    slug: name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, ""),
  }));

// Fallback to mock if no live stories
const displayStories =
  categoryStories.length > 0
    ? categoryStories
    : title === "Politics"
      ? VOX_HOME_DATA.politics
      : title === "Technology"
        ? VOX_HOME_DATA.latest
        : title === "Culture"
          ? VOX_HOME_DATA.culture
          : VOX_HOME_DATA.futurePerfect;

const isDarkHeader = isDarkHex(color);
const leadHeroImage = displayStories[0]?.heroImage || displayStories[0]?.imageUrl || null;
---

<MainLayout 
    title={`${title} - Explainer`}
    description={description}
>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": title,
        "description": description,
        "url": `https://explainer.africa/topic/${slug}`
    }).replace(/</g, '\\u003c')}
  />
  <main class="min-h-screen bg-[#fdfdfd]">
    {/* Compact Editorial Section Masthead */}
    <section
      class={`w-full py-8 md:py-11 px-6 relative overflow-hidden border-b-4 ${isDarkHeader ? "border-[#FAFF00]" : "border-black"}`}
      style={{ backgroundColor: color }}
    >
      {/* Atmospheric Backdrop: Lead Story Image + Radial Glow + Subtle Grid */}
      {leadHeroImage && (
        <div class="absolute inset-0 z-0 pointer-events-none">
          <img
            src={leadHeroImage}
            alt=""
            class={`w-full h-full object-cover ${isDarkHeader ? "opacity-20 mix-blend-luminosity" : "opacity-10 mix-blend-multiply"} scale-105`}
          />
          <div
            class="absolute inset-0"
            style={{
              background: isDarkHeader
                ? `linear-gradient(95deg, ${color} 35%, rgba(5,5,5,0.82) 70%, rgba(5,5,5,0.65) 100%)`
                : `linear-gradient(95deg, ${color} 45%, rgba(255,255,255,0.55) 100%)`,
            }}
          />
        </div>
      )}
      <div
        class="absolute -top-24 -right-24 w-[360px] h-[360px] rounded-full blur-[110px] pointer-events-none opacity-25"
        style={{ backgroundColor: isDarkHeader ? "#FAFF00" : accent }}
      />
      <div
        class="absolute inset-0 pointer-events-none opacity-[0.06]"
        style="background-image: radial-gradient(currentColor 1px, transparent 1px); background-size: 20px 20px;"
      />

      <div class="max-w-[1400px] mx-auto relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
        {/* Left: Editorial Title & Deck */}
        <div class="lg:col-span-8">
          <div class="flex flex-wrap items-center gap-2.5 mb-3.5">
            <a
              href="/"
              class={`text-[9px] font-black uppercase tracking-[0.25em] px-2.5 py-0.5 rounded-full border transition-colors ${
                isDarkHeader
                  ? "border-white/20 text-white/70 hover:text-[#FAFF00] hover:border-[#FAFF00]"
                  : "border-black/20 text-black/70 hover:text-black hover:border-black"
              }`}
            >
              Explainer
            </a>
            <span class={`text-xs ${isDarkHeader ? "text-white/30" : "text-black/30"}`}>/</span>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#FAFF00] text-black">
              <span class="w-1.5 h-1.5 rounded-full bg-black animate-pulse"></span>
              <span class="font-black uppercase tracking-[0.22em] text-[9px]">Section</span>
            </div>
          </div>

          <h1
            class={`font-serif-display font-black text-4xl sm:text-5xl md:text-6xl mb-3 ${headerText} tracking-tighter leading-[0.92]`}
          >
            {title}
          </h1>

          <div
            class="pl-4 border-l-4 max-w-2xl"
            style={{ borderColor: isDarkHeader ? "#FAFF00" : "#000000" }}
          >
            <p
              class={`text-base md:text-lg font-serif ${isDarkHeader ? "text-white/85" : "text-black/85"} text-balance leading-snug`}
            >
              {description}
            </p>
          </div>

          {relatedTopics.length > 0 && (
            <div class="mt-4 flex flex-wrap items-center gap-1.5">
              <span class={`text-[9px] font-black uppercase tracking-[0.22em] mr-1.5 ${isDarkHeader ? "text-white/45" : "text-black/50"}`}>
                Also Explore:
              </span>
              {relatedTopics.map((topic) => (
                <a
                  href={`/topic/${topic.slug}`}
                  class={`text-[9px] font-black uppercase tracking-[0.18em] px-2.5 py-1 rounded-full transition-all ${
                    isDarkHeader
                      ? "bg-white/10 text-white hover:bg-[#FAFF00] hover:text-black"
                      : "bg-black/10 text-black hover:bg-black hover:text-[#FAFF00]"
                  }`}
                >
                  {topic.name}
                </a>
              ))}
            </div>
          )}
        </div>

        {/* Right: Compact Desk Summary Card */}
        <div class="lg:col-span-4">
          <div
            class={`rounded-2xl p-4 md:p-5 backdrop-blur-xl border shadow-xl ${
              isDarkHeader
                ? "bg-white/[0.06] border-white/15 text-white"
                : "bg-white/85 border-black/15 text-black"
            }`}
          >
            <div class="flex items-center justify-between pb-2.5 mb-2.5 border-b border-current/10">
              <span class={`text-[9px] font-black uppercase tracking-[0.25em] ${isDarkHeader ? "text-[#FAFF00]" : "text-black/60"}`}>
                Desk Summary
              </span>
              <span class={`text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full ${isDarkHeader ? "bg-[#FAFF00] text-black" : "bg-black text-[#FAFF00]"}`}>
                {categoryStories.length} {categoryStories.length === 1 ? "Dispatch" : "Dispatches"}
              </span>
            </div>

            {displayStories[0] && (
              <a href={`/article/${displayStories[0].slug}`} class="group block">
                <p class={`text-[8px] font-black uppercase tracking-[0.22em] mb-1 ${isDarkHeader ? "text-white/50" : "text-black/50"}`}>
                  Lead Investigation
                </p>
                <p class={`font-serif-display font-bold text-base leading-snug mb-2 line-clamp-2 group-hover:underline ${isDarkHeader ? "group-hover:text-[#FAFF00]" : ""}`}>
                  {displayStories[0].headline || displayStories[0].title}
                </p>
                <div class={`flex items-center justify-between text-[9px] font-black uppercase tracking-widest ${isDarkHeader ? "text-[#FAFF00]" : "text-black"}`}>
                  <span>By {displayStories[0].author || "Staff"}</span>
                  <span class="group-hover:translate-x-1 transition-transform">Read →</span>
                </div>
              </a>
            )}
          </div>
        </div>
      </div>

      {/* Subtle Oversized Watermark */}
      <div class="absolute -bottom-8 -right-6 opacity-[0.04] pointer-events-none select-none">
        <span class={`font-serif-display font-black text-[10rem] leading-none ${headerText} whitespace-nowrap block`}>
          {title}
        </span>
      </div>
    </section>

    <div class="max-w-[1400px] mx-auto px-6 py-10 md:py-12">
      {displayStories.length > 0 && (
        <div class="mb-16">
            <div class="flex items-center justify-between mb-8 border-b-4 border-black pb-4">
                <h2 class="text-3xl md:text-4xl font-serif-display font-black text-black tracking-tighter">
                    Featured
                </h2>
            </div>
            {/* Featured Story (First Item) */}
            <article class="group relative w-full border border-gray-200 hover:border-black transition-colors bg-white hover:shadow-2xl flex flex-col md:flex-row">
                <div class="w-full md:w-[60%] aspect-[4/3] md:aspect-auto md:min-h-[500px] overflow-hidden relative bg-gray-100">
                    <a href={`/article/${displayStories[0].slug}`} class="block w-full h-full">
                        <img 
                            src={displayStories[0].heroImage || displayStories[0].imageUrl || '/social-preview.jpg'} 
                            alt={displayStories[0].headline || displayStories[0].title} 
                            class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-[1.5s] ease-out group-hover:scale-105"
                        />
                    </a>
                </div>
                <div class="w-full md:w-[40%] p-8 md:p-12 xl:p-16 flex flex-col justify-center bg-white relative z-10 border-t md:border-t-0 md:border-l border-gray-200">
                    <span class={`inline-block mb-6 text-[10px] font-black uppercase tracking-[0.2em] bg-black text-[#FAFF00] px-3 py-1 self-start shadow-sm`}>
                        {displayStories[0].category || title}
                    </span>
                    <h3 class="font-serif-display font-black text-4xl md:text-5xl leading-[1.05] mb-6 text-black tracking-tight group-hover:underline decoration-yellow-400 decoration-4 underline-offset-4">
                        <a href={`/article/${displayStories[0].slug}`}>
                        {displayStories[0].headline || displayStories[0].title}
                        </a>
                    </h3>
                    <p class="text-lg text-gray-600 font-serif leading-relaxed mb-8 border-l-4 pl-4" style={{ borderColor: accent }}>
                        {displayStories[0].subhead || "A deep dive into the underlying metrics shaping our contemporary understanding of this sector."}
                    </p>
                    <div class="flex items-center gap-3 mt-auto">
                        <span class="text-xs font-black uppercase tracking-widest text-black">By {displayStories[0].author || "Staff"}</span>
                    </div>
                </div>
            </article>
        </div>
      )}

      {/* The Rest of the Grid */}
      {displayStories.length > 1 && (
          <div>
            <div class="flex items-center justify-between mb-10">
                <h2 class="text-xs font-black uppercase tracking-widest text-gray-400">More in {title}</h2>
                <div class="h-px flex-1 bg-gray-200 ml-4"></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {displayStories.slice(1).map((story: any) => <StreamCard article={story} />)}
            </div>
          </div>
      )}
    </div>
  </main>
  <Footer />
</MainLayout>
