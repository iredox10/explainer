---
import MainLayout from "../../layouts/MainLayout.astro";
import StreamCard from "../../components/ui/StreamCard.astro";
import Footer from "../../components/Footer.astro";
import {
  serverStoryService,
  serverCategoryService,
} from "../../lib/server-appwrite.js";
import { VOX_HOME_DATA } from "../../data/mock";

export const prerender = false;

const { slug } = Astro.params;

// Fetch Live Category Data (never throw: page must still render)
let categoryRecord: any = null;
try {
  categoryRecord = await serverCategoryService.getCategoryBySlug(slug);
} catch (error: any) {
  console.error(`[TOPIC] Failed to fetch category "${slug}":`, error?.message || error);
}

// Logic mapping if the API is empty or for fallback styling
const categoryMap: Record<
  string,
  { title: string; description: string; color: string; accent: string }
> = {
  politics: {
    title: "Politics",
    description: "Power, policy, and the people who shape it.",
    color: "#BFDBFE",
    accent: "#2563EB",
  },
  technology: {
    title: "Technology",
    description: "The future is already here.",
    color: "#FEF08A",
    accent: "#CA8A04",
  },
  culture: {
    title: "Culture",
    description: "How we live, what we consume, and who we are.",
    color: "#FBCFE8",
    accent: "#DB2777",
  },
  science: {
    title: "Science",
    description: "Discoveries that change our understanding of the universe.",
    color: "#BBF7D0",
    accent: "#16A34A",
  },
};

// Derive a display name from the slug ("super-feature" -> "Super Feature")
const titleFromSlug = slug
  ? slug
      .split("-")
      .filter(Boolean)
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ")
  : "";

const fallbackData = slug ? categoryMap[slug] : null;

// Live record wins, then the static map, then the slug-derived name
const title = categoryRecord?.name || fallbackData?.title || titleFromSlug;

if (!title) {
  return Astro.redirect("/404");
}

const description =
  categoryRecord?.description ||
  fallbackData?.description ||
  "In-depth investigative journalism and visual storytelling.";

// Colors are stored as hex; only fall back to Vox yellow when no color exists
// (#000000 is a valid stored default for text-on-color backgrounds).
const color = categoryRecord?.color || fallbackData?.color || "#FAFF00";
const accent =
  categoryRecord?.accentColor ||
  categoryRecord?.accentClass ||
  fallbackData?.accent ||
  color;

// Categories default to #000000, so the header text cannot be hardcoded black.
const isDarkHex = (hex: string): boolean => {
  const match = /^#?([0-9a-f]{6})$/i.exec(String(hex).trim());
  if (!match) return false;
  const value = parseInt(match[1], 16);
  const r = (value >> 16) & 255;
  const g = (value >> 8) & 255;
  const b = value & 255;
  return (0.299 * r + 0.587 * g + 0.114 * b) / 255 < 0.5;
};

const headerText = isDarkHex(color) ? "text-white" : "text-black";

// Match stories against both the record name and the slug-derived name
const titleKeys = new Set(
  [title, titleFromSlug, slug?.replace(/-/g, " ")]
    .filter(Boolean)
    .map((value) => (value as string).trim().toLowerCase()),
);

// Fetch live stories for this category
const allPublished = await serverStoryService.getPublishedStories();
const categoryStories = allPublished.filter(
  (s: any) =>
    s?.category && titleKeys.has(String(s.category).trim().toLowerCase()),
);

// A slug with no category record, no static fallback and no published stories
// is a genuine miss, not an empty topic page.
if (!categoryRecord && !fallbackData && categoryStories.length === 0) {
  return Astro.redirect("/404");
}


// Fallback to mock if no live stories
const displayStories =
  categoryStories.length > 0
    ? categoryStories
    : title === "Politics"
      ? VOX_HOME_DATA.politics
      : title === "Technology"
        ? VOX_HOME_DATA.latest
        : title === "Culture"
          ? VOX_HOME_DATA.culture
          : VOX_HOME_DATA.futurePerfect;
---

<MainLayout 
    title={`${title} - Explainer`}
    description={description}
>
  <script type="application/ld+json" slot="head">
    {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": title,
        "description": description,
        "url": `https://explainer.africa/topic/${slug}`
    })}
  </script>
  <main class="min-h-screen bg-[#fdfdfd]">
    {/* Vox-style Bold Solid Color Header */}
    <div
      class="w-full py-16 md:py-28 px-6 border-b-8 border-black relative overflow-hidden transition-colors duration-500"
      style={{ backgroundColor: color }}
    >
      <div class="max-w-[1400px] mx-auto relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-12">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-8">
            <span class="w-3 h-3 bg-current rounded-full"></span>
            <span class={`font-black uppercase tracking-[0.25em] text-xs ${headerText}`}>Section</span>
          </div>
          <h1
            class={`font-serif-display font-black text-6xl md:text-8xl lg:text-[9rem] mb-6 ${headerText} tracking-tighter leading-[0.85]`}
          >
            {title}
          </h1>
          <p
            class={`text-2xl md:text-3xl font-serif ${headerText} max-w-2xl text-balance leading-snug`}
          >
            {description}
          </p>
        </div>
      </div>
      {/* Decorative background typography */}
      <div class="absolute -bottom-20 -right-10 opacity-[0.05] pointer-events-none select-none">
          <span class={`font-serif-display font-black text-[20rem] leading-none ${headerText} break-none whitespace-nowrap overflow-hidden block`}>
            {title}
          </span>
      </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
      {displayStories.length > 0 && (
        <div class="mb-24">
            <div class="flex items-center justify-between mb-8 border-b-4 border-black pb-4">
                <h2 class="text-3xl md:text-4xl font-serif-display font-black text-black tracking-tighter">
                    Featured
                </h2>
            </div>
            {/* Featured Story (First Item) */}
            <article class="group relative w-full border border-gray-200 hover:border-black transition-colors bg-white hover:shadow-2xl flex flex-col md:flex-row">
                <div class="w-full md:w-[60%] aspect-[4/3] md:aspect-auto md:min-h-[500px] overflow-hidden relative bg-gray-100">
                    <a href={`/article/${displayStories[0].slug}`} class="block w-full h-full">
                        <img 
                            src={displayStories[0].heroImage || displayStories[0].imageUrl || 'https://images.unsplash.com/photo-1585829365294-111320e7588e?w=1200'} 
                            alt={displayStories[0].headline || displayStories[0].title} 
                            class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-[1.5s] ease-out group-hover:scale-105"
                        />
                    </a>
                </div>
                <div class="w-full md:w-[40%] p-8 md:p-12 xl:p-16 flex flex-col justify-center bg-white relative z-10 border-t md:border-t-0 md:border-l border-gray-200">
                    <span class={`inline-block mb-6 text-[10px] font-black uppercase tracking-[0.2em] bg-black text-[#FAFF00] px-3 py-1 self-start shadow-sm`}>
                        {displayStories[0].category || title}
                    </span>
                    <h3 class="font-serif-display font-black text-4xl md:text-5xl leading-[1.05] mb-6 text-black tracking-tight group-hover:underline decoration-yellow-400 decoration-4 underline-offset-4">
                        <a href={`/article/${displayStories[0].slug}`}>
                        {displayStories[0].headline || displayStories[0].title}
                        </a>
                    </h3>
                    <p class="text-lg text-gray-600 font-serif leading-relaxed mb-8 border-l-4 pl-4" style={{ borderColor: accent }}>
                        {displayStories[0].subhead || "A deep dive into the underlying metrics shaping our contemporary understanding of this sector."}
                    </p>
                    <div class="flex items-center gap-3 mt-auto">
                        <span class="text-xs font-black uppercase tracking-widest text-black">By {displayStories[0].author || "Staff"}</span>
                    </div>
                </div>
            </article>
        </div>
      )}

      {/* The Rest of the Grid */}
      {displayStories.length > 1 && (
          <div>
            <div class="flex items-center justify-between mb-10">
                <h2 class="text-xs font-black uppercase tracking-widest text-gray-400">More in {title}</h2>
                <div class="h-px flex-1 bg-gray-200 ml-4"></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {displayStories.slice(1).map((story: any) => <StreamCard article={story} />)}
            </div>
          </div>
      )}
    </div>
  </main>
  <Footer />
</MainLayout>
