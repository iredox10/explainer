---
interface Props {
    message: string;
    href?: string;
}

const { message, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
    href={href}
    class:list={[
        'block w-full bg-black text-[#FAFF00] no-underline',
        href && 'hover:bg-[#111] transition-colors',
    ]}
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-3 py-2">
        <span class="inline-flex items-center gap-1.5 bg-[#FAFF00] text-black text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded-sm shrink-0">
            <span class="relative flex h-1.5 w-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-600 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-600"></span>
            </span>
            Breaking
        </span>
        <span class="text-xs sm:text-sm font-bold truncate">{message}</span>
        {href && <span class="ml-auto shrink-0 text-sm font-black" aria-hidden="true">→</span>}
    </div>
</Tag>
