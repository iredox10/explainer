---
import { serverStoryService } from "../../lib/server-appwrite.js";
import { Image } from "astro:assets";

interface Props {
  article: {
    title?: string;
    headline?: string;
    subhead?: string;
    category?: string;
    author?: string;
    imageUrl?: string;
    heroImage?: string;
    readTime?: string;
    slug?: string;
    content?: any;
  };
}

const { article } = Astro.props;
const displayTitle = article.headline || article.title;
const displayImage =
  article.imageUrl || article.heroImage || "/social-preview.jpg";
const displayCategory = article.category || "General";
const readTime = article.content
  ? serverStoryService.calculateReadTime(article.content)
  : 5;
const displayReadTime = `${readTime} min read`;
---

<article
  class="group flex flex-col w-full bg-white border border-gray-100 overflow-hidden hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] hover:-translate-y-1 transition-all duration-500 rounded-2xl relative"
>
  <!-- Glowing Hover Border -->
  <div
    class="absolute inset-0 border-2 border-transparent group-hover:border-[#FAFF00] rounded-2xl transition-colors duration-500 pointer-events-none z-10"
  >
  </div>

  <!-- Image -->
  <div class="w-full aspect-[4/3] overflow-hidden relative bg-gray-50">
    <Image
      src={displayImage}
      alt={displayTitle || "Story image"}
      width={600}
      height={450}
      class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-110"
    />
    <div
      class="absolute top-4 left-4 z-10 hidden group-hover:block animate-in fade-in duration-300"
    >
      <span
        class="px-3 py-1 bg-white/90 backdrop-blur-sm text-black text-[10px] font-black uppercase tracking-widest rounded-full shadow-lg"
        >Read Now</span
      >
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 md:p-8 flex flex-col flex-1">
    <div class="flex items-center gap-3 mb-4">
      <span
        class="text-[10px] font-black uppercase tracking-[0.2em] text-black bg-[#FAFF00] px-2 py-1 rounded-sm shadow-sm decoration-clone"
      >
        {displayCategory}
      </span>
      <span
        class="text-[10px] text-gray-400 uppercase tracking-widest font-bold"
      >
        {article.readTime || displayReadTime}
      </span>
    </div>

    <h3
      class="font-serif-display text-2xl lg:text-3xl font-bold leading-tight text-black mb-4 line-clamp-3"
    >
      <a
        href={article.slug ? `/article/${article.slug}` : "#"}
        class="before:absolute before:inset-0"
      >
        {displayTitle}
      </a>
    </h3>

    <p class="text-gray-500 text-sm leading-relaxed line-clamp-2 mt-auto">
      {
        article.subhead ||
          "Detailed analysis on why this matters now and how it affects the broader landscape of global events."
      }
    </p>

    <!-- Author block appended at bottom -->
    <div
      class="flex items-center gap-3 mt-6 pt-6 border-t border-dashed border-gray-200"
    >
      <div
        class="w-6 h-6 rounded-full bg-gray-100 flex items-center justify-center text-[10px] font-bold text-gray-500"
      >
        {(article.author || "Explainer").charAt(0)}
      </div>
      <span
        class="text-[10px] uppercase font-bold text-gray-400 tracking-widest"
        >{article.author || "Explainer"}</span
      >
    </div>
  </div>
</article>
