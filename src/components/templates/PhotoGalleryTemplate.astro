---
// src/components/templates/PhotoGalleryTemplate.astro
import MainLayout from "../../layouts/MainLayout.astro";
import VoxNav from "../../components/ui/VoxNav.astro";
import { Image } from "astro:assets";

const { story } = Astro.props;
const ARTICLE_DATA = story;

const slugify = (value: string): string =>
    value
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/-{2,}/g, '-')
        .replace(/^-+|-+$/g, '');

// Prefer the real publish timestamp, then the editor's free-text date.
const formatDisplayDate = (value: any) => {
    if (!value) return "";
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return String(value);
    return parsed.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
    });
};

const displayDate =
    formatDisplayDate(ARTICLE_DATA.publishedAt) ||
    formatDisplayDate(ARTICLE_DATA.date);

const getBlocks = (content: any) => {
    if (!content) return [];
    if (Array.isArray(content)) return content;
    if (typeof content === "string") {
        try {
            return JSON.parse(content);
        } catch (e) {
            return [];
        }
    }
    return [];
};

const blocks = getBlocks(ARTICLE_DATA.content);

import { serverStoryService } from "../../lib/server-appwrite.js";

// Prefer a stored read time, otherwise derive it from the body.
const storedReadTime = (value: any) => {
    if (!value) return "";
    if (typeof value === "number") return `${value} min read`;
    const text = String(value).trim();
    if (!text) return "";
    return /^\d+$/.test(text) ? `${text} min read` : text;
};

const computedReadTime = serverStoryService.calculateReadTime(blocks);
const displayReadTime =
    storedReadTime(ARTICLE_DATA.readTime) || `${computedReadTime} min read`;
---

<MainLayout
    title={ARTICLE_DATA.seo?.ogTitle || ARTICLE_DATA.headline}
    description={ARTICLE_DATA.seo?.ogDescription || ARTICLE_DATA.subhead}
    image={ARTICLE_DATA.seo?.ogImage || ARTICLE_DATA.heroImage || ARTICLE_DATA.imageUrl}
    canonical={ARTICLE_DATA.seo?.canonicalUrl}
    keywords={ARTICLE_DATA.seo?.keywords?.length ? ARTICLE_DATA.seo.keywords : ARTICLE_DATA.tags}
    article={ARTICLE_DATA}
    showNav={false}
>
    <div
        class="bg-black text-white font-sans antialiased min-h-screen selection:bg-yellow-300"
    >
        <VoxNav />

        <main>
            {/* Intro hero for the photo essay */}
            <section
                class="min-h-screen flex flex-col justify-center max-w-4xl mx-auto px-6 py-32 text-center"
            >
                <h1
                    class="font-serif-display font-black text-5xl md:text-8xl tracking-tight leading-none mb-8 text-white"
                >
                    {ARTICLE_DATA.headline}
                </h1>
                <p
                    class="text-xl md:text-2xl text-gray-400 font-serif leading-relaxed mb-12"
                >
                    {ARTICLE_DATA.subhead}
                </p>
                <p
                    class="text-xs font-black uppercase tracking-[0.2em] text-[#FAFF00]"
                >
                    Photography By <a href={`/author/${slugify(ARTICLE_DATA.author)}`} class="hover:underline">{ARTICLE_DATA.author}</a>
                </p>
                {displayDate && (
                    <p
                        class="mt-3 text-[10px] font-bold uppercase tracking-[0.25em] text-gray-500"
                    >
                        {displayDate}
                    </p>
                )}
                {displayReadTime && (
                    <p
                        class="mt-2 text-[10px] font-bold uppercase tracking-[0.25em] text-gray-500"
                    >
                        {displayReadTime}
                    </p>
                )}
                <div class="mt-20 animate-bounce text-gray-500 mx-auto w-max">
                    <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg
                    >
                </div>
            </section>

            {/* The Gallery Strip */}
            <section class="space-y-0 w-full overflow-hidden">
                {
                    blocks.map((block: any, index: number) => {
                        if (block.type === "image") {
                            return (
                                <figure class="relative w-full h-screen group">
                                    <img
                                        src={block.url}
                                        alt={block.caption || ""}
                                        class="w-full h-full object-cover grayscale opacity-90 transition-all duration-700 hover:grayscale-0 hover:opacity-100"
                                    />
                                    {block.caption && (
                                        <figcaption class="absolute bottom-12 left-6 md:left-24 max-w-xl bg-black/80 backdrop-blur p-6 border-l-4 border-[#FAFF00] transform transition-transform group-hover:-translate-y-2 opacity-0 group-hover:opacity-100 duration-500">
                                            <p class="font-sans text-lg md:text-2xl text-white font-medium leading-snug">
                                                {block.caption}
                                            </p>
                                        </figcaption>
                                    )}
                                </figure>
                            );
                        }
                        if (block.type === "p") {
                            return (
                                <div class="max-w-3xl mx-auto px-6 py-24 md:py-32 self-center">
                                    <p class="font-serif text-2xl md:text-3xl text-gray-300 leading-relaxed indent-12">
                                        <Fragment set:html={block.text} />
                                    </p>
                                </div>
                            );
                        }
                        if (block.type === "heading") {
                            return (
                                <div class="max-w-4xl mx-auto px-6 py-20 md:py-28">
                                    <h2 class="font-serif-display font-black text-4xl md:text-6xl tracking-tight leading-none text-white">
                                        <Fragment set:html={block.text} />
                                    </h2>
                                </div>
                            );
                        }
                        if (block.type === "quote") {
                            return (
                                <blockquote class="max-w-3xl mx-auto px-6 py-24 md:py-32 border-l-4 border-[#FAFF00] pl-8 font-serif text-3xl md:text-5xl italic text-gray-200 leading-tight">
                                    <Fragment set:html={block.text} />
                                    {block.author && (
                                        <cite class="block text-xs font-black uppercase tracking-[0.25em] text-[#FAFF00] mt-8 not-italic">
                                            — {block.author}
                                        </cite>
                                    )}
                                </blockquote>
                            );
                        }
                        if (block.type === "callout") {
                            return (
                                <div class="max-w-3xl mx-auto px-6 py-16">
                                    <div class="border border-gray-800 bg-white/5 p-8">
                                        <span class="text-[10px] font-black uppercase tracking-[0.25em] text-[#FAFF00] block mb-3">
                                            {block.title || "Note"}
                                        </span>
                                        <p class="font-serif text-xl md:text-2xl text-gray-200 leading-snug">
                                            <Fragment set:html={block.text} />
                                        </p>
                                    </div>
                                </div>
                            );
                        }
                        if (block.type === "video") {
                            return (
                                <figure class="relative w-full">
                                    <video
                                        src={block.url}
                                        class="w-full h-screen object-cover"
                                        controls={!block.autoplay}
                                        autoplay={block.autoplay}
                                        loop={block.loop}
                                        muted={block.muted}
                                        playsinline
                                    />
                                    {block.caption && (
                                        <figcaption class="max-w-3xl mx-auto px-6 py-8 text-[10px] font-black uppercase tracking-[0.25em] text-gray-500">
                                            {block.caption}
                                        </figcaption>
                                    )}
                                </figure>
                            );
                        }
                        if (
                            [
                                "map",
                                "chart",
                                "bottleneck",
                                "timeline",
                                "beforeAfter",
                                "inline-related",
                                "scrolly-group",
                            ].includes(block.type)
                        ) {
                            return (
                                <div class="max-w-3xl mx-auto px-6 py-16">
                                    <div class="bg-neutral-900 border border-gray-800 p-8">
                                        <span class="text-[10px] font-black uppercase tracking-[0.25em] text-[#FAFF00] block mb-3">
                                            {block.type === "scrolly-group"
                                                ? "Interactive feature"
                                                : block.type}
                                        </span>
                                        <h4 class="font-serif-display font-black text-2xl md:text-3xl text-white leading-tight">
                                            {block.title ||
                                                block.label ||
                                                "Visual story"}
                                        </h4>
                                        {(block.text ||
                                            block.caption ||
                                            block.description) && (
                                            <p class="font-serif text-lg text-gray-400 leading-relaxed mt-3">
                                                {block.text ||
                                                    block.caption ||
                                                    block.description}
                                            </p>
                                        )}
                                        <a
                                            href={`/article/${ARTICLE_DATA.slug}`}
                                            class="inline-flex items-center gap-2 mt-6 text-xs font-black uppercase tracking-[0.2em] text-[#FAFF00] hover:text-white transition-colors"
                                        >
                                            Open the full experience →
                                        </a>
                                    </div>
                                </div>
                            );
                        }
                        return (
                            <div class="max-w-3xl mx-auto px-6 py-16">
                                <div class="border-2 border-dashed border-gray-700 p-8 text-center">
                                    <span class="text-[10px] font-black uppercase tracking-[0.25em] text-gray-500">
                                        Unsupported block: {block.type || "unknown"}
                                    </span>
                                </div>
                            </div>
                        );
                    })
                }
            </section>

            {
                Array.isArray(ARTICLE_DATA.related) && ARTICLE_DATA.related.length > 0 && (
                    <section class="max-w-3xl mx-auto px-6 pt-16">
                        <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-gray-500 mb-6">
                            Related Stories
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            {ARTICLE_DATA.related.map((item: any) => (
                                <a
                                    href={`/article/${item.slug}`}
                                    class="group block bg-neutral-900 border border-gray-800 hover:border-[#FAFF00] transition-colors"
                                >
                                    {item.image && (
                                        <img
                                            src={item.image}
                                            alt={item.title || item.slug}
                                            class="w-full aspect-[16/10] object-cover"
                                            loading="lazy"
                                        />
                                    )}
                                    <h4 class="font-serif-display text-base font-black text-white leading-snug p-4 group-hover:text-[#FAFF00] transition-colors">
                                        {item.title || item.slug}
                                    </h4>
                                </a>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                Array.isArray(ARTICLE_DATA.tags) && ARTICLE_DATA.tags.length > 0 && (
                    <div class="max-w-3xl mx-auto px-6 pt-16">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-[10px] font-black uppercase tracking-[0.25em] text-gray-500 mr-2">
                                Tags
                            </span>
                            {ARTICLE_DATA.tags.map((tag: string) => (
                                <a
                                    href={`/search?q=${encodeURIComponent(tag)}`}
                                    class="text-[10px] font-black uppercase tracking-[0.15em] border border-gray-700 text-gray-300 px-2.5 py-1 hover:bg-[#FAFF00] hover:text-black hover:border-transparent transition-colors"
                                >
                                    {tag}
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }

            {/* Outro */}
            <section
                class="max-w-3xl mx-auto px-6 py-32 text-center border-t border-gray-900 mt-20"
            >
                <h3
                    class="font-serif-display font-black text-4xl text-white mb-6"
                >
                    Enjoyed this visual essay?
                </h3>
                <button
                    class="bg-[#FAFF00] text-black px-8 py-3 text-sm font-black uppercase tracking-widest hover:scale-105 transition-transform shadow-[0_0_20px_rgba(250,255,0,0.2)]"
                >
                    Explore More Photography
                </button>
            </section>
        </main>
    </div>
</MainLayout>
