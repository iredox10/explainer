---
// src/components/templates/BriefingTemplate.astro
import MainLayout from "../../layouts/MainLayout.astro";
import VoxNav from "../../components/ui/VoxNav.astro";
import ProgressBar from "../../components/ui/ProgressBar.jsx";
import ShareButtons from "../../components/ui/ShareButtons.jsx";
import BeforeAfter from "../../components/ui/BeforeAfter.jsx";
import { Clock } from "lucide-react";

const { story } = Astro.props;
const ARTICLE_DATA = story;

// Prefer the real publish timestamp, then the editor's free-text date.
const formatDisplayDate = (value: any) => {
    if (!value) return "";
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return String(value);
    return parsed.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
    });
};

const displayDate =
    formatDisplayDate(ARTICLE_DATA.publishedAt) ||
    formatDisplayDate(ARTICLE_DATA.date) ||
    "Just Now";

const getBlocks = (content: any) => {
    if (!content) return [];
    if (Array.isArray(content)) return content;
    if (typeof content === "string") {
        try {
            return JSON.parse(content);
        } catch (e) {
            return [];
        }
    }
    return [];
};

const blocks = getBlocks(ARTICLE_DATA.content);

import { serverStoryService } from "../../lib/server-appwrite.js";
const readTime = serverStoryService.calculateReadTime(blocks);
---

<MainLayout
    title={ARTICLE_DATA.seo?.ogTitle || ARTICLE_DATA.headline}
    description={ARTICLE_DATA.seo?.ogDescription || ARTICLE_DATA.subhead}
    image={ARTICLE_DATA.seo?.ogImage || ARTICLE_DATA.heroImage || ARTICLE_DATA.imageUrl}
    canonical={ARTICLE_DATA.seo?.canonicalUrl}
    keywords={ARTICLE_DATA.seo?.keywords?.length ? ARTICLE_DATA.seo.keywords : ARTICLE_DATA.tags}
    article={ARTICLE_DATA}
    showNav={false}
>
    <div
        class="bg-white text-black font-sans antialiased min-h-screen selection:bg-yellow-300"
    >
        <ProgressBar
            client:load
            title={ARTICLE_DATA.headline}
            author={ARTICLE_DATA.author}
        />
        <VoxNav />

        <main class="max-w-3xl mx-auto px-6 py-24 md:py-32">
            <div class="mb-12">
                <span
                    class="inline-block bg-red-600 text-white font-black uppercase text-[10px] tracking-widest px-2 py-1 mb-6"
                >
                    Briefing
                </span>
                <h1
                    class="font-sans font-black text-5xl md:text-6xl tracking-tight leading-[1.05] mb-6 text-balance"
                >
                    {ARTICLE_DATA.headline}
                </h1>
                <p
                    class="text-xl md:text-2xl text-gray-500 font-serif leading-snug mb-8"
                >
                    {ARTICLE_DATA.subhead}
                </p>

                <div
                    class="flex items-center justify-between border-y border-gray-200 py-4 mb-10"
                >
                    <div
                        class="flex items-center gap-4 text-xs font-bold uppercase tracking-widest text-gray-500"
                    >
                        <span class="text-black">{ARTICLE_DATA.author}</span>
                        <span>•</span>
                        <span>{displayDate}</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <span
                            class="text-[10px] font-black uppercase tracking-widest text-[#FAFF00] bg-black px-2 py-1 flex items-center gap-2"
                        >
                            <Clock className="w-3 h-3" />
                            {readTime} Min Read
                        </span>
                        <ShareButtons
                            client:load
                            title={ARTICLE_DATA.headline}
                        />
                    </div>
                </div>
            </div>

            <article
                class="font-serif text-lg leading-relaxed text-gray-800 space-y-6"
            >
                {
                    blocks.map((block: any) => {
                        if (block.type === "heading") {
                            return (
                                <h2 class="font-sans font-black text-2xl text-black mt-10 mb-4 tracking-tight">
                                    <Fragment set:html={block.text} />
                                </h2>
                            );
                        }
                        if (block.type === "p") {
                            return (
                                <p class="mb-6">
                                    <Fragment set:html={block.text} />
                                </p>
                            );
                        }
                        if (block.type === "image") {
                            return (
                                <figure class="my-10 -mx-6 sm:mx-0">
                                    <img
                                        src={block.url}
                                        class="w-full h-auto"
                                    />
                                    {block.caption && (
                                        <figcaption class="text-[10px] text-gray-400 font-sans uppercase tracking-widest mt-2 px-6 sm:px-0">
                                            {block.caption}
                                        </figcaption>
                                    )}
                                </figure>
                            );
                        }
                        if (block.type === "callout") {
                            return (
                                <div class="my-8 bg-gray-50 p-6 border-l-4 border-red-600">
                                    {block.title && (
                                        <span class="block text-[10px] font-black uppercase tracking-[0.2em] text-red-600 mb-2">
                                            {block.title}
                                        </span>
                                    )}
                                    <p class="font-sans font-medium text-gray-900 italic">
                                        "{block.text}"
                                    </p>
                                </div>
                            );
                        }
                        if (block.type === "quote") {
                            return (
                                <blockquote class="my-10 border-l-4 border-red-600 pl-6 font-serif text-2xl italic text-gray-700 leading-snug">
                                    <Fragment set:html={block.text} />
                                    {block.author && (
                                        <cite class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mt-4 not-italic">
                                            — {block.author}
                                        </cite>
                                    )}
                                </blockquote>
                            );
                        }
                        if (block.type === "video") {
                            return (
                                <figure class="my-10 -mx-6 sm:mx-0">
                                    <video
                                        src={block.url}
                                        class="w-full h-auto"
                                        controls={!block.autoplay}
                                        autoplay={block.autoplay}
                                        loop={block.loop}
                                        muted={block.muted}
                                        playsinline
                                    />
                                    {block.caption && (
                                        <figcaption class="text-[10px] text-gray-400 font-sans uppercase tracking-widest mt-2 px-6 sm:px-0">
                                            {block.caption}
                                        </figcaption>
                                    )}
                                </figure>
                            );
                        }
                        if (block.type === "beforeAfter") {
                            return (
                                <div class="my-10 -mx-6 sm:mx-0">
                                    <BeforeAfter
                                        client:visible
                                        leftImage={block.leftImage}
                                        rightImage={block.rightImage}
                                        leftLabel={block.leftLabel}
                                        rightLabel={block.rightLabel}
                                        caption={block.caption}
                                        displayMode={block.displayMode}
                                    />
                                </div>
                            );
                        }
                        if (block.type === "inline-related") {
                            return (
                                <div class="my-10 bg-gray-50 border-l-4 border-black p-6 pl-8">
                                    <span class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 mb-2 block">
                                        Related
                                    </span>
                                    <h4 class="font-sans font-black text-2xl text-black leading-tight">
                                        {block.title}
                                    </h4>
                                    {block.description && (
                                        <p class="font-sans text-sm text-gray-600 mt-2 leading-relaxed">
                                            {block.description}
                                        </p>
                                    )}
                                    {block.slug && (
                                        <a
                                            href={`/article/${block.slug}`}
                                            class="inline-flex items-center gap-2 mt-4 text-xs font-black uppercase tracking-[0.2em] text-black hover:text-red-600 transition-colors"
                                        >
                                            Read the story →
                                        </a>
                                    )}
                                </div>
                            );
                        }
                        if (
                            ["map", "chart", "bottleneck", "timeline", "scrolly-group"].includes(
                                block.type,
                            )
                        ) {
                            return (
                                <div class="my-10 bg-gray-50 border border-gray-200 p-6">
                                    <span class="text-[10px] font-black uppercase tracking-widest text-red-600 block mb-2">
                                        Interactive · {block.type}
                                    </span>
                                    <h4 class="font-sans font-black text-xl text-black leading-tight">
                                        {block.label ||
                                            block.title ||
                                            "Visual story"}
                                    </h4>
                                    {(block.text || block.caption) && (
                                        <p class="font-serif text-base text-gray-600 leading-relaxed mt-2">
                                            {block.text || block.caption}
                                        </p>
                                    )}
                                    <a
                                        href={`/article/${ARTICLE_DATA.slug}`}
                                        class="inline-flex items-center gap-2 mt-4 text-xs font-black uppercase tracking-[0.2em] text-black hover:text-red-600 transition-colors"
                                    >
                                        Open the full experience →
                                    </a>
                                </div>
                            );
                        }
                        return (
                            <div class="my-8 border-2 border-dashed border-gray-300 p-6 text-center">
                                <span class="text-[10px] font-black uppercase tracking-widest text-gray-400">
                                    Unsupported block: {block.type || "unknown"}
                                </span>
                            </div>
                        );
                    })
                }
            </article>

            <div class="mt-16 pt-8 border-t border-gray-200 text-center">
                <a
                    href="/"
                    class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-[0.2em] text-black hover:text-red-600 transition-colors"
                >
                    <svg
                        class="w-4 h-4 transform rotate-180"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                    >
                    Back to Front Page
                </a>
            </div>
        </main>
    </div>
</MainLayout>
